&soc {
	msm_bus: qcom,kgsl-busmon {
		label = "kgsl-busmon";
		compatible = "qcom,kgsl-busmon";
		operating-points-v2 = <&gpu_opp_table_v2>;
	};

	gpu_opp_table_v2: gpu-opp-table_v2 {
		compatible = "operating-points-v2";

		opp-982000000 {
			opp-hz = <0x0 982000000>;
			opp-microvolt = <404>;
		};

		opp-925000000 {
			opp-hz = <0x0 925000000>;
			opp-microvolt = <388>;
		};

		opp-855000000 {
			opp-hz = <0x0 855000000>;
			opp-microvolt = <300>;
		};

		opp-670000000 {
			opp-hz = <0x0 670000000>;
			opp-microvolt = <208>;
		};

		opp-587000000 {
			opp-hz = <0x0 587000000>;
			opp-microvolt = <140>;
		};

		opp-491000000 {
			opp-hz = <0x0 491000000>;
			opp-microvolt = <90>;
		};

		opp-400000000 {
			opp-hz = <0x0 400000000>;
			opp-microvolt = <56>;
		};

		opp-305000000 {
			opp-hz = <0x0 305000000>;
			opp-microvolt = <40>;
		};

		opp-150000000 {
			opp-hz = <0x0 150000000>;
			opp-microvolt = <16>;
		};
	};
};

&msm_gpu {
	qcom,chipid = <0x06050001>;

	/* GPU OPP data */
	operating-points-v2 = <&gpu_opp_table_v2>;

	/delete-property/qcom,initial-pwrlevel;
	/delete-node/qcom,gpu-pwrlevels;

	/* Power levels bins */
	qcom,gpu-pwrlevel-bins {
		compatible="qcom,gpu-pwrlevel-bins";
		#address-cells = <1>;
		#size-cells = <0>;

		qcom,gpu-pwrlevels-0 {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			qcom,speed-bin = <0x0>;
			qcom,initial-pwrlevel = <0x8>;
			qcom,throttle-pwrlevel = <0x0>;
			qcom,gpu-pwrlevel@0 {
				reg = <0>;
				qcom,gpu-freq = <0x3a882180>;
				qcom,bus-freq-ddr7 = <0xb>;
				qcom,bus-min-ddr7 = <0xb>;
				qcom,bus-max-ddr7 = <0xb>;
				qcom,bus-freq-ddr8 = <0xb>;
				qcom,bus-min-ddr8 = <0xb>;
				qcom,bus-max-ddr8 = <0xb>;
				qcom,acd-level = <0x802b5ffd>;
			};
			qcom,gpu-pwrlevel@1 {
				reg = <1>;
				qcom,gpu-freq = <0x37226140>;
				qcom,bus-freq-ddr7 = <0xb>;
				qcom,bus-min-ddr7 = <0xb>;
				qcom,bus-max-ddr7 = <0xb>;
				qcom,bus-freq-ddr8 = <0xb>;
				qcom,bus-min-ddr8 = <0xb>;
				qcom,bus-max-ddr8 = <0xb>;
				qcom,acd-level = <0x802b5ffd>;
			};
			qcom,gpu-pwrlevel@2 {
				reg = <2>;
				qcom,gpu-freq = <0x32f643c0>;
				qcom,bus-freq-ddr7 = <0xb>;
				qcom,bus-min-ddr7 = <0xb>;
				qcom,bus-max-ddr7 = <0xb>;
				qcom,bus-freq-ddr8 = <0xb>;
				qcom,bus-min-ddr8 = <0xb>;
				qcom,bus-max-ddr8 = <0xb>;
				qcom,acd-level = <0x802b5ffd>;
			};
			qcom,gpu-pwrlevel@3 {
				reg = <3>;
				qcom,gpu-freq = <0x27ef6380>;
				qcom,bus-freq-ddr7 = <0xb>;
				qcom,bus-min-ddr7 = <0xb>;
				qcom,bus-max-ddr7 = <0xb>;
				qcom,bus-freq-ddr8 = <0xb>;
				qcom,bus-min-ddr8 = <0xb>;
				qcom,bus-max-ddr8 = <0xb>;
				qcom,acd-level = <0x802b5ffd>;
			};
			qcom,gpu-pwrlevel@4 {
				reg = <4>;
				qcom,gpu-freq = <0x22fce8c0>;
				qcom,bus-freq-ddr7 = <0xb>;
				qcom,bus-min-ddr7 = <0xb>;
				qcom,bus-max-ddr7 = <0xb>;
				qcom,bus-freq-ddr8 = <0xb>;
				qcom,bus-min-ddr8 = <0xb>;
				qcom,bus-max-ddr8 = <0xb>;
				qcom,acd-level = <0x802b5ffd>;
			};
			qcom,gpu-pwrlevel@5 {
				reg = <5>;
