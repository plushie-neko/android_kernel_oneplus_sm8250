				qcom,bus-freq-ddr7 = <0x7>;
				qcom,bus-min-ddr7 = <0x6>;
				qcom,bus-max-ddr7 = <0x9>;
				qcom,bus-freq-ddr8 = <0x8>;
				qcom,bus-min-ddr8 = <0x6>;
				qcom,bus-max-ddr8 = <0x9>;
				qcom,acd-level = <0xa02b5ffd>;
			};
			qcom,gpu-pwrlevel@6 {
