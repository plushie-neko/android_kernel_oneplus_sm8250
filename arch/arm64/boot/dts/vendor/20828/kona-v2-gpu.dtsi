			};
		};

		qcom,gpu-pwrlevels-3 {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			qcom,speed-bin = <0x2>;
			qcom,initial-pwrlevel = <0x6>;
			qcom,throttle-pwrlevel = <0x0>;
			qcom,gpu-pwrlevel@0 {
				reg = <0>;
