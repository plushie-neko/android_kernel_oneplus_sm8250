				qcom,bus-max = <0x0>;
			};
		};

		qcom,gpu-pwrlevels-1 {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			qcom,speed-bin = <0x1>;
			qcom,initial-pwrlevel = <0x6>;
			qcom,throttle-pwrlevel = <0x0>;
			qcom,gpu-pwrlevel@0 {
